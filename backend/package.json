{
  "name": "carisca-backend",
  "version": "1.0.0",
  "private": true,
  "description": "CARISCA website REST API (Express + Sequelize + MySQL)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "db:migrate": "tsx src/scripts/migrate.ts up",
    "db:migrate:undo": "tsx src/scripts/migrate.ts down",
    "db:migrate:status": "tsx src/scripts/migrate.ts status",
    "db:seed": "tsx src/scripts/seed.ts",
    "admin:create": "tsx src/scripts/create-admin.ts",
    "import:wordpress": "tsx src/scripts/import-wordpress.ts",
    "prod:migrate": "node dist/scripts/migrate.js up",
    "prod:seed": "node dist/scripts/seed.js",
    "prod:admin:create": "node dist/scripts/create-admin.js",
    "docs:openapi": "tsx src/scripts/export-openapi.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "image-size": "2.0.4",
    "multer": "2.4.0",
    "mysql2": "3.24.5",
    "nodemailer": "10.0.15",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "sanitize-html": "2.18.0",
    "sequelize": "6.37.8",
    "swagger-ui-express": "5.0.1",
    "umzug": "3.8.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/sanitize-html": "2.16.2",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "9.39.5",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "3.2.7"
  }
}
