# ---------------------------------------------------------------------------
# CARISCA API — environment template. Copy to .env and fill in real values.
# Never commit the real .env file.
# ---------------------------------------------------------------------------

# development | production | test
NODE_ENV=development
# Local port. On cPanel/Passenger the platform supplies PORT automatically.
PORT=5000

# Public base URL of this API (no trailing slash). Used to build media URLs.
API_PUBLIC_URL=http://localhost:5000
# Browser origins allowed to call the API with cookies (comma-separated, exact match, no wildcards).
FRONTEND_URL=http://localhost:3000
# Number of reverse-proxy hops in front of Node (cPanel/Passenger: 1). Needed for correct client IPs.
TRUST_PROXY=1

# MySQL — use the host, database and user created in cPanel › MySQL Databases.
# The host is often "localhost" on cPanel, but use exactly what your provider specifies.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=carisca_website
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_TIMEZONE=+00:00
DB_LOGGING=false

# Session security. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret_of_at_least_32_characters
SESSION_COOKIE_NAME=carisca_sid
# Leave empty for a host-only cookie on the API domain (recommended).
COOKIE_DOMAIN=
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12

# Persistent upload storage OUTSIDE the deployment folder, e.g. /home/<cpanel-user>/carisca-storage
# Must contain (or be able to create) public/uploads and private/uploads. Defaults to ./storage.
STORAGE_DIR=
UPLOAD_MAX_IMAGE_MB=5
UPLOAD_MAX_DOCUMENT_MB=25

# Email (optional). Without SMTP, password-reset emails are disabled (admins reset passwords in the
# dashboard) and newsletter sign-ups are single opt-in with recorded consent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="CARISCA Website <no-reply@carisca.knust.edu.gh>"
# Inbox notified of new contact-form messages (optional).
CONTACT_NOTIFY_EMAIL=

# On-demand cache purge on the frontend after content changes.
REVALIDATE_URL=http://localhost:3000/api/revalidate
# Same value as REVALIDATE_SECRET in frontend environment.
REVALIDATE_SECRET=replace_with_a_random_secret_shared_with_the_frontend

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Swagger UI at /api/docs and the OpenAPI spec at /api/openapi.json.
# Defaults to on in development and OFF in production; set true to publish the docs.
API_DOCS_ENABLED=
